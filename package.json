{
  "name": "wikisubmission-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format",
    "format:check": "pnpm --filter web format:check",
    "test": "pnpm --filter web test",
    "test:coverage": "pnpm --filter web test:coverage",
    "test:contract": "pnpm --filter web test:contract",
    "audit:full": "node tools/audit.mjs",
    "audit:prod": "node tools/audit.mjs --prod --audit-level=high",
    "audit:test": "node --test tools/audit.test.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.3.1",
    "semver": "^7.8.5"
  }
}
