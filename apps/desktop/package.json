{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "WikiSubmission Quran: offline desktop app",
  "author": {
    "name": "WikiSubmission",
    "email": "contact@wikisubmission.org"
  },
  "homepage": "https://wikisubmission.org",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "host:dev": "node host/dev-host.mts",
    "host:static": "node host/dev-host.mts --static",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "lint": "eslint",
    "electron:build": "node electron/build.mjs",
    "electron:typecheck": "tsc -p electron/tsconfig.json",
    "electron": "node electron/build.mjs && electron .",
    "stage": "node scripts/stage-resources.mjs",
    "dist": "next build --webpack && node electron/build.mjs && node scripts/stage-resources.mjs && electron-builder",
    "dist:dir": "next build --webpack && node electron/build.mjs && node scripts/stage-resources.mjs && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "gsap": "^3.15.0",
    "lucide-react": "1.24.0",
    "next": "16.4.2",
    "next-intl": "^4.13.1",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zustand": "^5.0.14"
  }
}
